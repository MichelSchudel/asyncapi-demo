<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.craftsmen.asyncapidemo</groupId>
        <artifactId>asyncapi-demo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>order-service</artifactId>
    <packaging>jar</packaging>

    <name>order-service</name>
    <description>REST API that accepts orders and publishes OrderCreated events via Spring Cloud Stream</description>

    <properties>
        <springdoc-openapi.version>3.1.1</springdoc-openapi.version>
        <npx.executable>npx</npx.executable>
        <asyncapi.docs.output>${project.build.directory}/generated-resources/static/asyncapi-docs</asyncapi.docs.output>
        <asyncapi.models.root>${project.build.directory}/generated-sources/asyncapi-models</asyncapi.models.root>
        <asyncapi.models.package>nl.craftsmen.asyncapidemo.orderservice.event</asyncapi.models.package>
        <asyncapi.models.output>${asyncapi.models.root}/nl/craftsmen/asyncapidemo/orderservice/event</asyncapi.models.output>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream-binder-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-asyncapi-docs</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${npx.executable}</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>@asyncapi/cli</argument>
                                <argument>generate</argument>
                                <argument>fromTemplate</argument>
                                <argument>src/main/resources/order-events-send.yaml</argument>
                                <argument>@asyncapi/html-template@latest</argument>
                                <argument>-o</argument>
                                <argument>${asyncapi.docs.output}</argument>
                                <argument>--force-write</argument>
                                <argument>-i</argument>
                            </arguments>
                            <environmentVariables>
                                <PUPPETEER_SKIP_DOWNLOAD>true</PUPPETEER_SKIP_DOWNLOAD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-asyncapi-models</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${npx.executable}</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>@asyncapi/cli</argument>
                                <argument>generate</argument>
                                <argument>models</argument>
                                <argument>java</argument>
                                <argument>src/main/resources/order-events-send.yaml</argument>
                                <argument>-o</argument>
                                <argument>${asyncapi.models.output}</argument>
                                <argument>--packageName=${asyncapi.models.package}</argument>
                                <argument>--javaJackson</argument>
                                <argument>--javaArrayType=List</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-asyncapi-models-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${asyncapi.models.root}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
